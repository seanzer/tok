// The normalize kernel with its three passes over the list run in parallel.
fn normalize(xs: [f64]) -> [f64]
  n = xs.len()
  var sum = 0.0
  par for x in xs
    sum += x
  m = sum / f64(n)
  var sq = 0.0
  par for x in xs
    sq += (x - m) * (x - m)
  s = sqrt(sq / f64(n))
  par for x in xs -> (x - m) / s

fn main(args: [str]) ! io
  n = args[0].to_int() or 1000000
  rounds = args[1].to_int() or 8
  var xs: [f64] = []
  for i in 1..n
    xs.push(f64(i % 1000) * 0.5)
  var total = 0.0
  for r in 1..rounds
    ys = normalize(xs)
    total = total + ys[r] + ys[n / 2] + (max(ys) or 0.0)
  print(int(total * 1000.0))

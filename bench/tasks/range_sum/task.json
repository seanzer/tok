{
 "id": "range_sum",
 "prompt": "The two arguments are integers. Print the sum of all integers between them, including both, whichever of the two is larger.",
 "tests": [
  {
   "args": [
    "1",
    "4"
   ],
   "stdout": "10\n"
  },
  {
   "args": [
    "4",
    "1"
   ],
   "stdout": "10\n"
  },
  {
   "args": [
    "5",
    "5"
   ],
   "stdout": "5\n"
  },
  {
   "args": [
    "-3",
    "3"
   ],
   "stdout": "0\n"
  },
  {
   "args": [
    "1",
    "100"
   ],
   "stdout": "5050\n"
  }
 ]
}

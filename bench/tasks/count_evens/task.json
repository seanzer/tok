{
 "id": "count_evens",
 "prompt": "The arguments are integers. Print how many of them are even.",
 "tests": [
  {
   "args": [
    "1",
    "2",
    "3",
    "4"
   ],
   "stdout": "2\n"
  },
  {
   "args": [],
   "stdout": "0\n"
  },
  {
   "args": [
    "2",
    "4",
    "6"
   ],
   "stdout": "3\n"
  },
  {
   "args": [
    "7"
   ],
   "stdout": "0\n"
  },
  {
   "args": [
    "0",
    "-2",
    "-3"
   ],
   "stdout": "2\n"
  }
 ]
}

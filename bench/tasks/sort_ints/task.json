{
 "id": "sort_ints",
 "prompt": "The arguments are integers. Print them in ascending order on one line, separated by single spaces. With no arguments print an empty line.",
 "tests": [
  {
   "args": [
    "3",
    "1",
    "2"
   ],
   "stdout": "1 2 3\n"
  },
  {
   "args": [],
   "stdout": "\n"
  },
  {
   "args": [
    "5",
    "-1",
    "5",
    "0"
   ],
   "stdout": "-1 0 5 5\n"
  },
  {
   "args": [
    "9"
   ],
   "stdout": "9\n"
  },
  {
   "args": [
    "10",
    "9",
    "8",
    "7",
    "6",
    "5"
   ],
   "stdout": "5 6 7 8 9 10\n"
  }
 ]
}

fn kind(a: int, b: int, c: int) -> str
  if a + b <= c or a + c <= b or b + c <= a
    return "invalid"
  if a == b and b == c
    return "equilateral"
  if a == b or b == c or a == c
    return "isosceles"
  "scalene"

fn main(args: [str]) ! io
  print(kind(args[1].to_int() or 0, args[2].to_int() or 0, args[3].to_int() or 0))

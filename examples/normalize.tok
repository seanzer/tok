// Design doc Example B: the normalize kernel, plus a main to run it.
// One deviation from the doc's text: mean of an empty list is `none`, so each mean gets a default.
fn normalize(xs: [f64]) -> [f64]
  m = mean(xs) or 0.0
  s = sqrt(mean(xs.map(x -> (x - m) * (x - m))) or 1.0)
  xs.map(x -> (x - m) / s)

fn main() ! io
  xs = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
  print("mean {mean(xs)}, max {max(xs)}")
  print(normalize(xs))
